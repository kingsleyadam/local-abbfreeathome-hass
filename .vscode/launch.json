{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Test Home Assistant versions",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/.github/scripts/test_ha_versions.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Test Home Assistant versions (HTML coverage)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/.github/scripts/test_ha_versions.py",
      "args": ["--html"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Test one Home Assistant version",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/.github/scripts/test_ha_versions.py",
      "args": ["--ha", "${input:haVersion}"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Test Home Assistant dev",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/.github/scripts/test_ha_versions.py",
      "args": ["--ha", "dev"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Check compatibility markers",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/.github/scripts/check_compat.py",
      "args": ["--list"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Preview compatibility code to remove",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/.github/scripts/check_compat.py",
      "args": ["--minimum", "${input:haMinimum}"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ],
  "inputs": [
    {
      "id": "haVersion",
      "type": "promptString",
      "description": "Home Assistant version, e.g. 2026.6 (newest patch), 2026.6.2, 2026.7.0b1, or dev"
    },
    {
      "id": "haMinimum",
      "type": "promptString",
      "description": "Minimum Home Assistant version to preview, e.g. 2026.8"
    }
  ]
}
