  "services": {
    "virtual_device": {
      "name": "Virtuelles Gerät",
      "description": "Virtuelles Free@home-Gerät erstellen oder aktualisieren. In den Einstellungen aktivieren, neue Geräte im Grundriss platzieren und die Integration neu laden.",
