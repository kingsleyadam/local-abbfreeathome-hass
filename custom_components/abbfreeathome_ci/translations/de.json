        "energy_meter": {
          "name": "Erweiterte Energiezähler-Einstellungen"
        }
      },
      "fields": {
        "config_entry_id": {
          "name": "System Access Point",
          "description": "Wählen Sie die zu verwendende ABB-free@home-Integration aus. Optional, wenn nur eine eingerichtet ist; erforderlich bei mehreren Integrationen."
        },
        "serial": {
          "name": "Virtuelle Geräte-ID",
          "description": "Die ursprüngliche nativeId, nicht die erzeugte Geräteseriennummer 6000.... Verwenden Sie 1-64 Buchstaben, Ziffern, Unterstriche oder Bindestriche, zum Beispiel ha-virtual-switch-01. Verwenden Sie dieselbe ID, um dieses Gerät zu aktualisieren."
        },
        "type": {
          "name": "Gerätetyp",
          "description": "Wählen Sie einen Gerätetyp oder geben Sie einen eigenen API-Typ ein. Wetterstationen benötigen keine weiteren Einstellungen zur Erstellung."
        },
        "ttl": {
          "name": "Lebensdauer",
          "description": "Wählen Sie eine Vorgabe oder geben Sie Sekunden ein. Standardwert: -1 (unbegrenzt). 0 markiert das Gerät nur als nicht erreichbar; löschen Sie es manuell in der Free@home-App. Befristete Lebensdauern müssen 180-86400 Sekunden betragen und benötigen regelmäßige Keepalive-Aufrufe."
        },
        "displayname": {
          "name": "Gerätename",
          "description": "Anzeigename in Free@home. Beim Erstellen angeben; beim Aktualisieren weglassen, um den Namen unverändert zu lassen."
        },
        "flavor": {
          "name": "Energiezähler-Variante",
          "description": "Nur für EnergyMeterv2. Standardwert bei fehlender Angabe: E, auch bei Aktualisierungen. Geben Sie eine eigene Variante explizit an, um diese beizubehalten."
        },
        "capabilities": {
          "name": "Energiezähler-Funktions-IDs",
          "description": "Nur für EnergyMeterv2. Standardwert: [16, 17, 18, 19, 22, 28]. Dieser erzeugt Zähler-, Batterie- und Wechselrichterkanäle, auch bei Aktualisierungen. Eigene Fähigkeiten als Liste ganzer Zahlen angeben, um diese beizubehalten; eine leere Liste bleibt erhalten."
        }
      }
    }
