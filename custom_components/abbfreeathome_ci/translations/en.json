  "services": {
    "virtual_device": {
      "name": "Virtual device",
      "description": "Create or update a Free@home virtual device. Enable virtual devices in the integration settings, place new devices on the Free@home floorplan, then reload the integration. Link real Home Assistant entities using automations.",
      "sections": {
        "energy_meter": {
          "name": "Advanced energy meter settings"
        }
      },
      "fields": {
        "config_entry_id": {
          "name": "System Access Point",
          "description": "Choose the ABB-free@home integration to use. Optional when only one is configured; required when several are configured."
        },
        "serial": {
          "name": "Virtual device ID",
          "description": "The original nativeId, not the generated 6000... device serial. Choose 1-64 letters, numbers, underscores, or hyphens, for example ha-virtual-switch-01. Reuse the same ID to update that device."
        },
        "type": {
          "name": "Device type",
          "description": "Select a device type or enter a custom API type. Weather stations need no extra creation settings."
        },
        "ttl": {
          "name": "Lifetime",
          "description": "Choose a preset or enter custom seconds. Defaults to -1 (unlimited). 0 only marks the device unresponsive; delete it manually in the Free@home app. Timed lifetimes must be 180-86400 seconds and require keepalive calls."
        },
        "displayname": {
          "name": "Device name",
          "description": "Display name in Free@home. Set this when creating a device; omit it when updating to leave the name unchanged."
        },
        "flavor": {
          "name": "Energy meter flavor",
          "description": "For EnergyMeterv2 only. Defaults to E when omitted, including on updates. Set this explicitly to keep a custom flavor."
        },
        "capabilities": {
          "name": "Energy meter capability IDs",
          "description": "For EnergyMeterv2 only. Defaults to [16, 17, 18, 19, 22, 28], creating meter, battery, and inverter channels, including on updates. Set a list of integers to keep custom capabilities; an empty list is preserved."
        }
      }
    }
  }
